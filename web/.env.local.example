# Optional overrides. Copy to `.env.local` (not committed) and edit.

# Which network the site talks to: mainnet | testnet | anvil
# VITE_NETWORK=testnet

# Your own RPC instead of the public one, e.g. an Alchemy URL.
# Anything starting with VITE_ ends up in the public site, so restrict the key to your domain in Alchemy.
# VITE_RPC_URL=https://robinhood-testnet.g.alchemy.com/v2/YOUR_KEY
